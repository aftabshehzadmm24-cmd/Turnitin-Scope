# Server-side AI or Not key for AI detection. Never expose it as a VITE_ variable.
AIORNOT_API_KEY=aion_prod_a32608c5694641589e35bc31a573ed4ab992aef8100e435c9006043508bbc5b4

# Public backend URL used by the Vercel frontend at build time.
VITE_API_URL="https://YOUR-RAILWAY-SERVICE.up.railway.app"

# Comma-separated browser origins allowed to call the backend; no trailing slash required.
FRONTEND_ORIGIN="https://your-domain.vercel.app"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
