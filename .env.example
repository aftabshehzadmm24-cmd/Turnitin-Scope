# Server-side TruthScan key for AI detection. Never expose it as a VITE_ variable.
TRUTHSCAN_API_KEY="YOUR_TRUTHSCAN_API_KEY"

# Public backend URL used by the Vercel frontend at build time.
VITE_API_URL="https://YOUR-RAILWAY-SERVICE.up.railway.app"

# Comma-separated browser origins allowed to call the backend; no trailing slash required.
FRONTEND_ORIGIN="https://your-domain.vercel.app"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
